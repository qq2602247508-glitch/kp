# Local AI COC KP Assistant — isolated defaults
COC_KP_ENVIRONMENT=development
COC_KP_API_PREFIX=/api/v1
COC_KP_HOST=127.0.0.1
COC_KP_PORT=8010
COC_KP_FRONTEND_ORIGIN=http://127.0.0.1:5180
COC_KP_DATABASE_URL=sqlite:///./data/coc_kp.db
COC_KP_VECTOR_STORE_PATH=./data/vectors

# Reuse locally installed models. Setup never downloads models.
COC_KP_OLLAMA_BASE_URL=http://127.0.0.1:11434
COC_KP_INTENT_MODEL=qwen3:30b-instruct
COC_KP_REASONING_MODEL=qwen3:30b-instruct
COC_KP_EMBEDDING_MODEL=bge-m3:latest

# This namespace is intentionally exclusive to COC seventh-edition material.
COC_KP_RAG_COLLECTION_NAME=coc7_rules
COC_KP_RAG_CORPUS_JSON_ROOT=./data/generated-content/coc7/json
COC_KP_RAG_MANIFEST_PATH=./data/vectors/coc7_rules-manifest.json
COC_KP_RAG_SEARCH_TOP_K=6
COC_KP_RAG_SEARCH_CANDIDATE_K=18
COC_KP_RAG_SEARCH_MIN_SCORE=0.45

